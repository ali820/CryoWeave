{
  "name": "@cryo-research/lake-mapper",
  "version": "0.1.0",
  "private": true,
  "description": "Extract water polygons from masks or indices and calculate lake area, perimeter, centroid, elongation, compactness, shape index, and fractal dimension.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lake_worker.py",
    "requirements.txt",
    "README.md",
    "VALIDATION.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
